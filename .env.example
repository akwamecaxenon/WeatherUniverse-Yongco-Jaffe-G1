# Copy this file to .env and fill in your own values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL (local) or Supabase (Project Settings > Database > Connection string)
DB_NAME=weather_universe
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=5432
# Supabase requires SSL; use "require" there, "prefer" for local PostgreSQL
DB_SSLMODE=prefer
